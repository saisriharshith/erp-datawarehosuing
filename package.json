{
  "name": "erp-decision-support-mern-stack",
  "version": "2.0.0",
  "description": "Institutional ERP Data Warehouse & Decision Support System (MERN Stack: MongoDB Atlas, Express, React, Node)",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "server:watch": "node --watch server/server.js",
    "client": "npm run dev --prefix frontend",
    "client:build": "npm run build --prefix frontend",
    "build": "npm install && npm install --prefix server && npm install --prefix frontend && npm run build --prefix frontend",
    "dev": "node server/server.js",
    "seed": "node server/src/scripts/seed.js",
    "etl": "node server/src/etl/pipeline.js",
    "test": "NODE_ENV=test node --test server/tests/api.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4"
  },
  "keywords": [
    "mern",
    "mongodb-atlas",
    "express",
    "react",
    "node",
    "data-warehouse",
    "decision-support"
  ],
  "author": "Google DeepMind Pair Programming",
  "license": "MIT"
}
