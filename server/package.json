{
  "name": "erp-decision-support-server",
  "version": "2.0.0",
  "description": "ERP Data Warehouse & Institutional Decision Support System - Express & Node Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "cd .. && npm install && npm install --prefix frontend && npm run build --prefix frontend",
    "dev": "node --watch server.js",
    "seed": "node src/scripts/seed.js",
    "etl": "node src/etl/pipeline.js",
    "optimize-db": "node src/scripts/optimizeIndexes.js",
    "test": "NODE_ENV=test node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.21.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4"
  }
}
