# ==============================================================================
# ERP Data Warehouse & Decision Support System Environment Configuration
# ==============================================================================

# Flask Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5001
SECRET_KEY=super-secret-key-change-in-production

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
SOURCE_DB_NAME=erp_source
WAREHOUSE_DB_NAME=erp_warehouse

# CORS Configuration (Allowed frontend origin)
# Local Frontend: http://localhost:3000 or http://127.0.0.1:5500
# Production Frontend: https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
